{
  "manifest_version": 3,
  "name": "轻航 LiteNav",
  "version": "0.0.0",
  "key": "",
  "description": "轻量的个人网址与服务导航：新标签页即工作台，离线可用，通过 Chrome 账号在多台电脑间同步。",
  "homepage_url": "https://github.com/clam314/LiteNav",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开轻航",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "favicon",
    "search"
  ],
  "optional_permissions": [
    "webRequest",
    "bookmarks"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
